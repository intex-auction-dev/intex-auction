{
  "name": "intex-auction",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24 <25",
    "npm": "11.6.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "check:contract-profile": "node scripts/build/check-contract-profile.mjs",
    "check:layers": "node scripts/build/check-layer-boundaries.mjs",
    "typecheck": "npm run check:contract-profile && tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "build": "vite build && node scripts/build/verify-production-bundle.mjs",
    "build:dev-controls": "vite build --config dev/local-chain/controls/vite.config.mjs",
    "smoke": "npm run smoke:http && npm run smoke:start",
    "verify": "npm run check:biome && npm run check:layers && npm run typecheck && npm run test:unit && npm run build && npm run smoke",
    "start": "node scripts/server/start.mjs",
    "smoke:http": "node scripts/server/smoke.mjs",
    "smoke:start": "node scripts/server/startup-smoke.mjs",
    "local:anvil": "node dev/local-chain/scripts/local/infrastructure/local-env.mjs up",
    "local:seed": "node dev/local-chain/scripts/local/commands/local-seed.mjs",
    "local:advance": "node dev/local-chain/scripts/local/commands/local-advance.mjs",
    "local:oracle-walk": "node dev/local-chain/scripts/local/commands/local-oracle-walk.mjs",
    "local:control": "node dev/local-chain/scripts/local/commands/local-control.mjs",
    "local:web": "node dev/local-chain/scripts/local/infrastructure/dev-local.mjs",
    "local:reset": "node dev/local-chain/scripts/local/infrastructure/local-env.mjs reset",
    "local:down": "node dev/local-chain/scripts/local/infrastructure/local-env.mjs down",
    "local:status": "node dev/local-chain/scripts/local/infrastructure/local-env.mjs status",
    "local:smoke": "node dev/local-chain/scripts/local/infrastructure/local-smoke.mjs",
    "test:contracts:local": "node dev/local-chain/scripts/local/infrastructure/local-contract-tests.mjs",
    "test:local-scenarios": "node dev/local-chain/scripts/local/scenarios/local-scenario-checks.mjs",
    "local:stage-boundaries": "node dev/local-chain/scripts/local/commands/local-stage-boundaries.mjs",
    "test:phases:local": "node dev/local-chain/scripts/runners/run-phase7-local.mjs && node dev/local-chain/scripts/runners/run-phase8-local.mjs && node dev/local-chain/scripts/runners/run-phase9-local.mjs && node dev/local-chain/scripts/runners/run-phase10-local.mjs && node dev/local-chain/scripts/runners/run-phase12-local.mjs",
    "test:local-controls": "node dev/local-chain/scripts/runners/run-local-controls.mjs",
    "test:e2e:local": "playwright test",
    "check": "npm run check:biome && npm run check:layers && npm run typecheck && npm run test:unit && npm run build",
    "check:ci-paths": "node dev/local-chain/scripts/ci-local-contracts-needed.mjs --self-test",
    "release:package": "npm run build && node scripts/release/release-package.mjs",
    "release:verify": "node scripts/release/release-package.mjs --verify",
    "check:biome": "biome ci ."
  },
  "author": "Intex Auction contributors",
  "license": "ISC",
  "description": "Static bidder application for Intex auctions",
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/geist": "5.3.0",
    "@walletconnect/ethereum-provider": "2.23.10",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "uplot": "1.6.32",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@yarnpkg/cli-dist": "4.9.3",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  }
}
